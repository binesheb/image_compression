using System;
using System.Drawing;
using System.Drawing.Imaging;

namespace ImageCompression
{
    class Program
    {
        static void Main(string[] args)
        {
            string sourceImagePath;

            if (args.Length > 0)
            {
                // If a file was dragged and dropped onto the program window, use it as the input file
                sourceImagePath = args[0];
            }
            else
            {
                Console.Write("Enter the input file path: ");
                sourceImagePath = Console.ReadLine();
            }

            if (string.IsNullOrWhiteSpace(sourceImagePath))
            {
                Console.WriteLine("Please provide an input image path.");
                return;
            }

            if (!System.IO.File.Exists(sourceImagePath))
            {
                Console.WriteLine("The input image file does not exist.");
                return;
            }

            Console.Write("Enter the desired file size in KB: ");
            if (!long.TryParse(Console.ReadLine(), out long desiredFileSizeKB) || desiredFileSizeKB <= 0)
            {
                Console.WriteLine("Please enter a positive whole number of kilobytes.");
                return;
            }

            const long bytesPerKilobyte = 1024;
            if (desiredFileSizeKB > long.MaxValue / bytesPerKilobyte)
            {
                Console.WriteLine("The requested file size is too large.");
                return;
            }

            long desiredFileSizeBytes = desiredFileSizeKB * bytesPerKilobyte;

            using Bitmap sourceImage = new Bitmap(sourceImagePath);
            using EncoderParameters encoderParams = new EncoderParameters(1);
            encoderParams.Param[0] = new EncoderParameter(Encoder.Quality, 99L);
            using System.IO.MemoryStream ms = new System.IO.MemoryStream();

            sourceImage.Save(ms, GetEncoderInfo("image/jpeg"), encoderParams);

            Console.Write("Enter the output file path: ");
            string outputImagePath = Console.ReadLine();
            if (!TryGetOutputPath(sourceImagePath, outputImagePath, out string validatedOutputPath))
            {
                return;
            }

            if (ms.Length <= desiredFileSizeBytes)
            {
                System.IO.File.WriteAllBytes(validatedOutputPath, ms.ToArray());
                Console.WriteLine($"Image compression complete. Output file size: {ms.Length / 1024} KB.");
                return;
            }

            int compressionLevel = 98;
            while (ms.Length > desiredFileSizeBytes && compressionLevel > 0)
            {
                compressionLevel--;
                encoderParams.Param[0] = new EncoderParameter(Encoder.Quality, compressionLevel);
                ms.SetLength(0);
                ms.Position = 0;
                sourceImage.Save(ms, GetEncoderInfo("image/jpeg"), encoderParams);
            }

            System.IO.File.WriteAllBytes(validatedOutputPath, ms.ToArray());

            if (ms.Length <= desiredFileSizeBytes)
            {
                Console.WriteLine($"Image compression complete. Output file size: {ms.Length / 1024} KB.");
            }
            else
            {
                Console.WriteLine($"Target size could not be reached with the available JPEG quality range. Best available output size: {ms.Length / 1024} KB.");
            }
        }

        private static bool TryGetOutputPath(string sourceImagePath, string outputImagePath, out string validatedOutputPath)
        {
            validatedOutputPath = string.Empty;

            if (string.IsNullOrWhiteSpace(outputImagePath))
            {
                Console.WriteLine("Please provide an output file path.");
                return false;
            }

            try
            {
                string sourceFullPath = System.IO.Path.GetFullPath(sourceImagePath);
                string outputFullPath = System.IO.Path.GetFullPath(outputImagePath);
                if (string.Equals(sourceFullPath, outputFullPath, StringComparison.OrdinalIgnoreCase))
                {
                    Console.WriteLine("The output file must be different from the source image.");
                    return false;
                }

                if (System.IO.File.Exists(outputFullPath))
                {
                    Console.WriteLine("The output file already exists. Choose a different output path to avoid overwriting it.");
                    return false;
                }

                string? outputDirectory = System.IO.Path.GetDirectoryName(outputFullPath);
                if (!string.IsNullOrEmpty(outputDirectory) && !System.IO.Directory.Exists(outputDirectory))
                {
                    Console.WriteLine("The output directory does not exist.");
                    return false;
                }

                validatedOutputPath = outputFullPath;
                return true;
            }
            catch (ArgumentException)
            {
                Console.WriteLine("Please provide a valid output file path.");
                return false;
            }
            catch (NotSupportedException)
            {
                Console.WriteLine("The output file path is not supported.");
                return false;
            }
        }

        private static ImageCodecInfo GetEncoderInfo(string mimeType)
        {
            ImageCodecInfo[] codecs = ImageCodecInfo.GetImageEncoders();
            foreach (ImageCodecInfo codec in codecs)
            {
                if (codec.MimeType == mimeType)
                {
                    return codec;
                }
            }

            throw new InvalidOperationException($"No image encoder is available for MIME type '{mimeType}'.");
        }

        static Program()
        {
            Console.Title = "Image Compressor by binesheb";
        }
    }
}
